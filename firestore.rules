rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields:
    //   - uid: string (required)
    //   - name: string (required)
    //   - email: string (required)
    //   - role: string (required, ['student', 'teacher', 'parent', 'school_admin'])
    //   - country: string (optional)
    //   - photoURL: string (optional)
    //   - createdAt: timestamp (required)
    //
    // Collection: tutors
    // Fields:
    //   - userId: string (required)
    //   - subjects: list (required)
    //   - hourlyRate: number (required)
    //   - experience: string (optional)
    //   - bio: string (optional)
    //   - rating: number (optional)
    //   - reviewCount: number (optional)
    //
    // Collection: classes
    // Fields:
    //   - tutorId: string (required)
    //   - subject: string (required)
    //   - scheduledTime: timestamp (required)
    //   - duration: number (required)
    //   - videoSessionLink: string (optional)
    //   - status: string (required, ['scheduled', 'completed', 'cancelled'])
    //
    // Collection: bookings
    // Fields:
    //   - studentId: string (required)
    //   - tutorId: string (required)
    //   - classId: string (required)
    //   - paymentStatus: string (required, ['pending', 'paid', 'refunded'])
    //   - createdAt: timestamp (required)
    //
    // Collection: assignments
    // Fields:
    //   - classId: string (required)
    //   - studentId: string (required)
    //   - title: string (required)
    //   - description: string (optional)
    //   - submissionFile: string (optional)
    //   - grade: string (optional)
    //   - feedback: string (optional)
    //   - dueDate: timestamp (optional)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'school_admin' ||
         (request.auth.token.email == "pneumasleuth@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt']) &&
             data.uid is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string &&
             data.role in ['student', 'teacher', 'parent', 'school_admin'] &&
             data.createdAt is timestamp &&
             (!('username' in data) || (data.username is string && data.username.size() >= 3 && data.username.size() <= 30));
    }

    function isValidForum(data) {
      return data.keys().hasAll(['name', 'description', 'category', 'createdAt', 'createdBy']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.description is string && data.description.size() < 500 &&
             data.category is string &&
             data.createdAt is timestamp &&
             data.createdBy is string;
    }

    function isValidForumPost(data) {
      return data.keys().hasAll(['forumId', 'authorId', 'authorName', 'content', 'createdAt']) &&
             data.forumId is string &&
             data.authorId is string &&
             data.authorName is string &&
             data.content is string && data.content.size() > 0 && data.content.size() < 5000 &&
             data.createdAt is timestamp;
    }

    function isValidForumMember(data) {
      return data.keys().hasAll(['forumId', 'userId', 'joinedAt']) &&
             data.forumId is string &&
             data.userId is string &&
             data.joinedAt is timestamp;
    }

    function isForumMember(forumId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/forumMembers/$(forumId + "_" + request.auth.uid));
    }

    function isValidUserBook(data) {
      return data.keys().hasAll(['userId', 'bookId', 'downloadedAt']) &&
             data.userId is string &&
             data.bookId is string &&
             data.downloadedAt is timestamp;
    }

    function isValidTutor(data) {
      return data.keys().hasAll(['userId', 'name', 'photoURL', 'subjects', 'hourlyRate']) &&
             data.userId is string &&
             data.name is string &&
             data.photoURL is string &&
             data.subjects is list &&
             data.hourlyRate is number && data.hourlyRate >= 0;
    }

    function isValidClass(data) {
      return data.keys().hasAll(['tutorId', 'subject', 'scheduledTime', 'duration', 'status']) &&
             data.tutorId is string &&
             data.subject is string &&
             data.scheduledTime is timestamp &&
             data.duration is number &&
             data.status in ['scheduled', 'completed', 'cancelled'];
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['studentId', 'tutorId', 'classId', 'paymentStatus', 'createdAt']) &&
             data.studentId is string &&
             data.tutorId is string &&
             data.classId is string &&
             data.paymentStatus in ['pending', 'paid', 'refunded'] &&
             data.createdAt is timestamp;
    }

    function isValidSchool(data) {
      return data.keys().hasAll(['userId', 'name', 'photoURL', 'schoolName', 'verified', 'createdAt']) &&
             data.userId is string &&
             data.name is string &&
             data.photoURL is string &&
             data.schoolName is string && data.schoolName.size() > 0 &&
             data.verified is bool &&
             data.createdAt is timestamp;
    }

    function isValidClassroom(data) {
      return data.keys().hasAll(['schoolId', 'teacherId', 'name', 'subject']) &&
             data.schoolId is string &&
             data.teacherId is string &&
             data.name is string && data.name.size() > 0 &&
             data.subject is string && data.subject.size() > 0;
    }

    function isValidActivity(data) {
      return data.keys().hasAll(['classroomId', 'title', 'weekNumber']) &&
             data.classroomId is string &&
             data.title is string && data.title.size() > 0 &&
             data.weekNumber is number;
    }

    function isValidEnrollment(data) {
      return data.keys().hasAll(['classroomId', 'studentId', 'schoolId']) &&
             data.classroomId is string &&
             data.studentId is string &&
             data.schoolId is string;
    }

    // Rules
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role == resource.data.role;
    }

    match /schools/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidSchool(request.resource.data);
      allow update: if isOwner(userId) && isValidSchool(request.resource.data);
    }

    match /tutors/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidTutor(request.resource.data);
      allow update: if isOwner(userId) && isValidTutor(request.resource.data);
    }

    match /classes/{classId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidClass(request.resource.data);
      allow update: if isAuthenticated() && isValidClass(request.resource.data);
    }

    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.studentId) || isOwner(resource.data.tutorId));
      allow create: if isAuthenticated() && isOwner(request.resource.data.studentId) && isValidBooking(request.resource.data);
      allow update: if isAuthenticated() && (isOwner(resource.data.studentId) || isOwner(resource.data.tutorId)) && isValidBooking(request.resource.data);
    }

    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.studentId) || isAuthenticated()); // Simplified for MVP
      allow create: if isAuthenticated() && isValidClass(request.resource.data); // Simplified
      allow update: if isAuthenticated();
    }

    match /books/{bookId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /userBooks/{userBookId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId) && isValidUserBook(request.resource.data);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    match /forums/{forumId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /forumPosts/{postId} {
      allow read: if isAuthenticated() && isForumMember(resource.data.forumId);
      allow create: if isAuthenticated() && isForumMember(request.resource.data.forumId) && 
                    isOwner(request.resource.data.authorId) && isValidForumPost(request.resource.data);
      allow delete: if isAuthenticated() && isOwner(resource.data.authorId);
    }

    match /forumMembers/{memberId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId) && isValidForumMember(request.resource.data);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    match /classrooms/{classroomId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (isOwner(request.resource.data.schoolId) || isAdmin());
      
      match /activities/{activityId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && (isOwner(get(/databases/$(database)/documents/classrooms/$(classroomId)).data.teacherId) || isAdmin());
      }
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.studentId) || isOwner(resource.data.schoolId) || isAdmin());
      allow create: if isAuthenticated() && (isOwner(request.resource.data.schoolId) || isAdmin());
      allow delete: if isAuthenticated() && (isOwner(resource.data.schoolId) || isAdmin());
    }
  }
}
